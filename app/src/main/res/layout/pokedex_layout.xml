<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cLayoutPokedex"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rojo_pokedex">


    <androidx.cardview.widget.CardView
        android:id="@+id/cardView2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:padding="5dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="10dp"
        app:layout_constraintBottom_toTopOf="@+id/btAyuda"
        app:layout_constraintEnd_toEndOf="@+id/cardView"
        app:layout_constraintStart_toStartOf="@+id/cardView">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cvSpritePkmn"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginTop="2dp"
                app:cardBackgroundColor="@color/bg_campo_azul"
                app:cardCornerRadius="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivSpritePkmn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="false"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/placeholder" />
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:id="@+id/cvNombrePokemon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                app:cardBackgroundColor="@color/bg_campo_azul"
                app:cardCornerRadius="5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/cvSpritePkmn"
                app:layout_constraintTop_toTopOf="@+id/cvSpritePkmn">

                <TextView

                    android:id="@+id/tvNombrePkmn"
                    style="@style/textoComparacionDefault"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:backgroundTintMode="add"
                    android:text="Filtro"
                    tools:layout_editor_absoluteX="104dp" />
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:id="@+id/cvTipo1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/bg_campo_azul"
                app:cardCornerRadius="5dp"
                app:layout_constraintEnd_toStartOf="@+id/space3"
                app:layout_constraintStart_toStartOf="@+id/cvNombrePokemon"
                app:layout_constraintTop_toBottomOf="@+id/cvNombrePokemon">

                <TextView
                    android:id="@+id/tvTipo1Pkmn"
                    style="@style/textoComparacionDefault"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Tipo 1"
                    tools:layout_editor_absoluteX="104dp"
                    tools:layout_editor_absoluteY="24dp" />

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cvTipo2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_campo_azul"
                app:cardCornerRadius="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/cvTipo1"
                app:layout_constraintEnd_toEndOf="@+id/cvNombrePokemon"
                app:layout_constraintStart_toEndOf="@+id/space3"
                app:layout_constraintTop_toTopOf="@+id/cvTipo1">


                <TextView
                    android:id="@+id/tvTipo2Pkmn"
                    style="@style/textoComparacionDefault"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Tipo 2" />
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:id="@+id/cvPesoPokemon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_campo_azul"
                app:cardCornerRadius="5dp"
                app:layout_constraintBottom_toTopOf="@+id/cvEtapaPokemon"
                app:layout_constraintEnd_toStartOf="@+id/space3"
                app:layout_constraintStart_toStartOf="@+id/cvNombrePokemon"
                app:layout_constraintTop_toBottomOf="@+id/cvTipo1">

                <TextView
                    android:id="@+id/tvPesoPokemon"
                    style="@style/textoComparacionDefault"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Peso"
                    tools:layout_editor_absoluteX="104dp"
                    tools:layout_editor_absoluteY="48dp" />


            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:id="@+id/cvAlturaPokemon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_campo_azul"
                app:cardCornerRadius="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/cvPesoPokemon"
                app:layout_constraintEnd_toEndOf="@+id/cvNombrePokemon"
                app:layout_constraintStart_toEndOf="@+id/space3"
                app:layout_constraintTop_toTopOf="@+id/cvPesoPokemon">

                <TextView
                    android:id="@+id/tvAlturaPkmn"
                    style="@style/textoComparacionDefault"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Altura"
                    tools:layout_editor_absoluteX="290dp"
                    tools:layout_editor_absoluteY="43dp" />


            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:id="@+id/cvEtapaPokemon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                app:cardBackgroundColor="@color/bg_campo_azul"
                app:cardCornerRadius="5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/space3"
                app:layout_constraintStart_toStartOf="@+id/cvNombrePokemon">

                <TextView
                    android:id="@+id/tvEtapaPkmn"
                    style="@style/textoComparacionDefault"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Etapa"
                    tools:layout_editor_absoluteX="104dp"
                    tools:layout_editor_absoluteY="72dp" />

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cvRegionPokemon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_campo_azul"
                app:cardCornerRadius="5dp"
                app:layout_constraintEnd_toEndOf="@+id/cvNombrePokemon"
                app:layout_constraintStart_toEndOf="@+id/space3"
                app:layout_constraintTop_toTopOf="@+id/cvEtapaPokemon">

                <TextView
                    android:id="@+id/tvRegionPkmn"
                    style="@style/textoComparacionDefault"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Región"
                    tools:layout_editor_absoluteX="290dp"
                    tools:layout_editor_absoluteY="64dp" />

            </androidx.cardview.widget.CardView>

            <Space
                android:id="@+id/space3"
                android:layout_width="10dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/cvNombrePokemon"
                app:layout_constraintStart_toStartOf="@+id/cvNombrePokemon"
                app:layout_constraintTop_toBottomOf="@+id/cvNombrePokemon" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btAyuda"
        style="@style/botones"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:text="@string/ayuda"
        app:cornerRadius="12dp"
        app:iconTint="#e0e1dd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:rippleColor="#415a77" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cvActv"
        android:layout_width="382dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:padding="5dp"
        app:cardBackgroundColor="@color/pokedex_background"
        app:cardCornerRadius="8dp"
        app:layout_constraintEnd_toEndOf="@+id/cardView"
        app:layout_constraintStart_toStartOf="@+id/cardView"
        app:layout_constraintTop_toTopOf="parent">

        <AutoCompleteTextView
            android:id="@+id/actvPokedex"
            style="@style/textoComparacionDefault"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:completionThreshold="1"
            android:enabled="false"
            android:hint="Aquí tengo q ver q hago"
            android:singleLine="true" />
    </androidx.cardview.widget.CardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:padding="5dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="8dp"
        app:layout_constraintBottom_toTopOf="@+id/cardView2"
        app:layout_constraintEnd_toEndOf="@+id/btAyuda"
        app:layout_constraintStart_toStartOf="@+id/tvCantidad"
        app:layout_constraintTop_toBottomOf="@+id/cvActv"
        app:strokeColor="@color/pokedex_borde"
        app:strokeWidth="3dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pokedexRv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/pokedex_background"
            tools:itemCount="3"
            tools:listitem="@layout/pokemon_layout_placeholder" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvCantidad"
        style="@style/textoComparacionDefault"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Pokemons:"
        android:textColor="#e0e1dd"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@+id/btAyuda"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btAyuda" />

</androidx.constraintlayout.widget.ConstraintLayout>