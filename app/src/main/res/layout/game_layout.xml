<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gameMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rojo_pokedex">


    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="home_layout.xml" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="home_layout.xml" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btResetGame"
        style="@style/botones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:text="Reiniciar"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="@+id/cardView"
        app:layout_constraintTop_toTopOf="parent"
        app:rippleColor="#415a77" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btAyuda"
        style="@style/botones"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:text="@string/ayuda"
        app:cornerRadius="12dp"
        app:iconTint="#e0e1dd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:rippleColor="#415a77" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cvActv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="5dp"
        app:cardBackgroundColor="@color/pokedex_background"
        app:cardCornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/btResetGame"
        app:layout_constraintEnd_toStartOf="@+id/btResetGame"
        app:layout_constraintStart_toStartOf="@+id/tvCantidad"
        app:layout_constraintTop_toTopOf="@+id/btResetGame">

        <AutoCompleteTextView
            android:id="@+id/actvGame"
            style="@style/textoComparacionDefault"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:completionThreshold="1"
            android:singleLine="true" />
    </androidx.cardview.widget.CardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:padding="5dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="8dp"
        app:layout_constraintBottom_toTopOf="@+id/btAyuda"
        app:layout_constraintEnd_toEndOf="@+id/btAyuda"
        app:layout_constraintStart_toStartOf="@+id/tvCantidad"
        app:layout_constraintTop_toBottomOf="@+id/btResetGame"
        app:strokeColor="@color/pokedex_borde"
        app:strokeWidth="3dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/gameRv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/pokedex_background"
            tools:itemCount="3"
            tools:listitem="@layout/pokemon_layout_placeholder" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        style="@style/textoComparacionDefault"
        android:id="@+id/tvCantidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="TextView"
        android:textColor="#e0e1dd"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@+id/btAyuda"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btAyuda" />

</androidx.constraintlayout.widget.ConstraintLayout>