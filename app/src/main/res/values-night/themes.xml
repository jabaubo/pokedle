<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Pokedle2" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
    </style>

    <style name="textoComparacionDefault">
        <item name="fontFamily">@font/pokemon_xy</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:padding">0.25dp</item>
        <item name="backgroundColor">@color/bg_campo_azul</item>
    </style>

    <style name="textoComparacionIncorrecto">
        <item name="fontFamily">@font/pokemon_xy</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:padding">0.25dp</item>
        <item name="backgroundColor">@color/bg_campo_azul</item>
        <item name="android:textColor">@color/texto_incorrecto</item>
    </style>

    <style name="textoComparacionParcialmenteCorrecta">
        <item name="fontFamily">@font/pokemon_xy</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:padding">0.25dp</item>
        <item name="backgroundColor">@color/bg_campo_azul</item>
        <item name="android:textColor">@color/texto_correcto_parcialmente</item>
    </style>


    <style name="textoComparacionCorrecta">
        <item name="fontFamily">@font/pokemon_xy</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:padding">0.25dp</item>
        <item name="backgroundColor">@color/bg_campo_azul</item>
        <item name="android:textColor">@color/texto_correcto</item>
    </style>

    <style name="botones">
        <item name="fontFamily">@font/pokemon_xy</item>
        <item name="android:padding">0.25dp</item>
        <item name="backgroundTint">@color/rojo_pokedex_botones</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="Theme.Pokedle2" parent="Base.Theme.Pokedle2" />
</resources>